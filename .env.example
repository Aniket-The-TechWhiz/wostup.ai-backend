# Core Application & Security
NODE_ENV=development
PORT=5000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=5h

# Database & Cache Layer
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=startup_navigator
REDIS_URL=redis://127.0.0.1:6379

# Brevo (Sendinblue) Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=support@wostup.tech
BREVO_SENDER_NAME=Startup Navigator

# Email Verification Settings
EMAIL_VERIFICATION_URL=http://localhost:5000/api/auth/email-verification/verify
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
